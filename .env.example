# ────────────────────────────────────────────────────────────────────────────
# .env.example - 이 파일을 복사해서 .env 로 사용하세요
#   cp .env.example .env
# ────────────────────────────────────────────────────────────────────────────
# ⚠️  .env 파일은 절대 Git에 커밋하지 마세요! (.gitignore에 이미 추가됨)

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=myuser
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=kids_app

# database.py 에서 읽는 DB 연결 URL
# ▸ 로컬 직접 실행 시 (uvicorn main:app 으로 실행):
MY_APP_DATABASE_URL=postgresql://myuser:yourpassword@localhost:5432/kids_app
# ▸ Docker Compose 실행 시: docker-compose.yml 이 자동으로 db 호스트명으로 덮어씁니다.

# ─── JWT 인증 ────────────────────────────────────────────────────────────────
# ⚠️ 반드시 openssl rand -hex 32 로 생성한 랜덤 문자열을 사용하세요
SECRET_KEY=your-super-secret-key-change-this-in-production

# ─── AI API 키 ───────────────────────────────────────────────────────────────
# AI_PROVIDER 로 어떤 AI를 사용할지 선택합니다 (기본값: claude)
AI_PROVIDER=claude

# Claude (AI_PROVIDER=claude 일 때 필수)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024

# Gemini (AI_PROVIDER=gemini 일 때 필수)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (추후 GPT 전환 또는 RAG(LangChain) 임베딩 사용 시)
OPENAI_API_KEY=your-openai-api-key-here

# ─── 건강보험심사평가원 (병원 운영시간 조회) ──────────────────────────────────
# 공공데이터포털 신청: https://www.data.go.kr/data/15001698/openapi.do
# (서비스명: 건강보험심사평가원_의료기관 휴진정보 조회 서비스)
HIRA_SERVICE_KEY=your-hira-service-key-here

# ─── Kakao Maps API (병원 검색 기능 필수) ────────────────────────────────────
# 1. https://developers.kakao.com 접속
# 2. 내 애플리케이션 → 앱 추가
# 3. 앱 설정 → 앱 키 → REST API 키 복사
KAKAO_REST_API_KEY=your-kakao-rest-api-key-here

# ─── 앱 설정 ─────────────────────────────────────────────────────────────────
APP_ENV=development
# 프로덕션에서는 실제 프론트엔드 도메인으로 변경 (예: https://yourapp.com)
ALLOWED_ORIGINS=*

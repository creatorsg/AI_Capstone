# .env.prod.example  -  production environment variable template
#
# Usage:
#   cp .env.prod.example .env.prod
#   Fill in real values, then upload to server
#
# WARNING: Never commit .env.prod to Git (.gitignore should include it)

# App environment
APP_ENV=production

# Database (AWS RDS PostgreSQL)
# Format: postgresql://<user>:<password>@<rds-endpoint>:5432/<dbname>
MY_APP_DATABASE_URL=postgresql://postgres:PASSWORD@your-rds-endpoint.amazonaws.com:5432/fount_db

# JWT authentication
# Use at least 32 random characters (python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=CHANGE_ME_USE_STRONG_RANDOM_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP=30
REFRESH_TOKEN_EXP=7

# AI provider (claude | gemini | mock)
AI_PROVIDER=claude

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024

# Gemini (optional - only needed if AI_PROVIDER=gemini)
# GEMINI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXX
# GEMINI_MODEL=gemini-1.5-flash

# OpenAI (for RAG embeddings - juhyeong RAG pipeline)
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXX

# Kakao Maps API
# Get REST API key from https://developers.kakao.com
KAKAO_REST_API_KEY=KAKAO_REST_API_KEY_HERE

# HIRA public API
HIRA_SERVICE_KEY=HIRA_SERVICE_KEY_HERE

# CORS (frontend domain)
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Chat settings
CHAT_HISTORY_TURNS=10
